# Copy to .env.local and fill in (see README → "Google Sheets backup setup").
# OAuth client of type "Web application" — required on Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth client of type "iOS" — required on iPhone.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional: your own Android package name / iOS bundle identifier.
APP_BUNDLE_ID=com.assetmanager.app
